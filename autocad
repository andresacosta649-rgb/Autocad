<script>
  // Navegación entre secciones
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      item.classList.add('active');
      document.getElementById(item.dataset.section).classList.add('active');
    });
  });

  // Tabs
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const parent = tab.parentElement;
      const section = parent.closest('.section') || parent.parentElement;
      parent.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      section.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      const tabId = 'tab-' + tab.dataset.tab;
      const target = section.querySelector('#' + tabId);
      if (target) target.classList.add('active');
    });
  });

  // Copiar código
  function copyCode(id) {
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = event.target;
      const original = btn.innerText;
      btn.innerText = '✓ Copiado';
      btn.style.background = 'var(--success)';
      btn.style.color = 'var(--bg-primary)';
      setTimeout(() => {
        btn.innerText = original;
        btn.style.background = '';
        btn.style.color = '';
      }, 2000);
    });
  }

  // Guardar configuración
  function guardarConfig() {
    const config = {
      rutaProyecto: document.getElementById('ruta-proyecto').value,
      rutaSalida: document.getElementById('ruta-salida').value,
      kwPlanta: document.getElementById('kw-planta').value,
      kwFachada: document.getElementById('kw-fachada').value,
      kwPrincipal: document.getElementById('kw-principal').value,
      capasEsenciales: document.getElementById('capas-esenciales').value,
      papel: document.getElementById('papel').value,
      ctb: document.getElementById('ctb').value,
      escala: document.getElementById('escala').value
    };
    localStorage.setItem('archisys-config', JSON.stringify(config));
    alert('✅ Configuración guardada correctamente');
  }

  function resetConfig() {
    localStorage.removeItem('archisys-config');
    location.reload();
  }

  // Cargar configuración guardada
  window.addEventListener('load', () => {
    const saved = localStorage.getItem('archisys-config');
    if (saved) {
      try {
        const config = JSON.parse(saved);
        if (config.rutaProyecto) document.getElementById('ruta-proyecto').value = config.rutaProyecto;
        if (config.rutaSalida) document.getElementById('ruta-salida').value = config.rutaSalida;
        if (config.kwPlanta) document.getElementById('kw-planta').value = config.kwPlanta;
        if (config.kwFachada) document.getElementById('kw-fachada').value = config.kwFachada;
        if (config.kwPrincipal) document.getElementById('kw-principal').value = config.kwPrincipal;
        if (config.capasEsenciales) document.getElementById('capas-esenciales').value = config.capasEsenciales;
      } catch (e) { console.error('Error cargando config:', e); }
    }
  });

  // Simular exportación
  function simularExport() {
    const progress = document.getElementById('export-progress');
    const fill = document.getElementById('export-fill');
    const percent = document.getElementById('export-percent');
    const status = document.getElementById('export-status');
    progress.style.display = 'block';
    
    let p = 0;
    const steps = [
      { p: 15, msg: '📐 Configurando layouts...' },
      { p: 35, msg: '🏠 Procesando Planta Arquitectónica...' },
      { p: 55, msg: '🏢 Procesando Fachadas Principales...' },
      { p: 75, msg: '🏗️ Procesando Fachadas Secundarias...' },
      { p: 90, msg: '📄 Generando archivos PDF...' },
      { p: 100, msg: '✅ ¡Exportación completada!' }
    ];
    
    let i = 0;
    const interval = setInterval(() => {
      if (i < steps.length) {
        fill.style.width = steps[i].p + '%';
        percent.innerText = steps[i].p + '%';
        status.innerText = steps[i].msg;
        i++;
      } else {
        clearInterval(interval);
        setTimeout(() => {
          alert('✅ Planos finales exportados exitosamente a ENTREGA_FINAL/');
        }, 500);
      }
    }, 800);
  }
</script>

