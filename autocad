<pre id="code-lisp">(defun c:ComponerPlanosFinales (/ doc)
  (vl-load-com)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  
  (prompt "\n🏗️ COMPOSICIÓN DE PLANOS ARQUITECTÓNICOS")
  
