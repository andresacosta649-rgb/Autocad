<pre id="code-python">import os
import shutil
import re
from pathlib import Path

# --- CONFIGURACIÓN ---
CARPETA_PROYECTO = Path(r"C:\Proyectos\CASA01")
CARPETA_ORIGINALES = CARPETA_PROYECTO / "ORIGINALES"
CARPETA_LIMPIA = CARPETA_PROYECTO / "PARA_PROCESAR"
CARPETA_FINAL = CARPETA_PROYECTO / "ENTREGA_FINAL"

for carpeta in [CARPETA_ORIGINALES, CARPETA_LIMPIA, CARPETA_FINAL]:
    carpeta.mkdir(exist_ok=True)

def extraer_version(nombre):
    match = re.search(r'v(\d+)', nombre, re.IGNORECASE)
    return int(match.group(1)) if match else 0

def clasificar_archivos():
    archivos = list(CARPETA_ORIGINALES.glob("*.dwg"))
    categorias = {
        'planta': [],
        'fachada_principal': [],
        'fachada_secundaria': []
    }
    
    for archivo in archivos:
        nombre_lower = archivo.name.lower()
        version = extraer_version(archivo.name)
        fecha = archivo.stat().st_mtime
        
        if any(kw in nombre_lower for kw in ['planta', 'plano']):
            categorias['planta'].append((archivo, version, fecha))
        elif any(kw in nombre_lower for kw in ['fachada', 'alzado', 'elevacion']):
            if any(kw in nombre_lower for kw in ['principal', 'frontal', 'norte', 'sur']):
                categorias['fachada_principal'].append((archivo, version, fecha))
            else:
                categorias['fachada_secundaria'].append((archivo, version, fecha))
    
    seleccionados = {}
    for categoria, archivos_list in categorias.items():
        if archivos_list:
            archivos_list.sort(key=lambda x: (x[1], x[2]), reverse=True)
            seleccionados[categoria] = archivos_list[0][0]
    
    return seleccionados

def preparar_archivos(seleccionados):
    for categoria, archivo in seleccionados.items():
        destino = CARPETA_LIMPIA / f"{categoria.upper()}_LIMPIO.dwg"
        shutil.copy2(archivo, destino)
        print(f"✅ {categoria}: {archivo.name} -> {destino.name}")
    return seleccionados

if __name__ == "__main__":
    print("🏗️ SISTEMA DE COMPOSICIÓN ARQUITECTÓNICA")
    seleccionados = clasificar_archivos()
    if seleccionados:
        preparar_archivos(seleccionados)
        print("✅ PROCESO COMPLETADO")
    else:
        print("⚠️ No se encontraron archivos")</pre>
