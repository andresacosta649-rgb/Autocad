  (vlax-for layer (vla-get-Layers doc)
    (setq nombre (vla-get-Name layer))
    (if (not (member nombre capas_mantener))
      (command "._LAYDEL" "_N" nombre "")))
  
  (command "._PURGE" "_A" "*" "_N")
  
  ;; FASE 2: Crear layouts
  (command "._LAYOUT" "_N" "01_PLANTA_ARQUITECTONICA")
  (command "._LAYOUT" "_N" "02_FACHADAS_PRINCIPALES")
  
  ;; FASE 3: Exportar a PDF
  (vlax-for layout (vla-get-Layouts doc)
    (setq nombre (vla-get-Name layout))
    (if (or (wcmatch nombre "*PLANTA*")
            (wcmatch nombre "*FACHADA*"))
      (command "-PLOT" "_Y" nombre "DWG To PDF.pc3" 
               "ISO full bleed A3 (420.00 x 297.00 MM)" 
               "_M" "_L" "_N" "_E" "1:1" "_C" "_Y" 
               "monochrome.ctb" "_Y" "_N" "_N" "_N" 
               (strcat (getvar "DWGPREFIX") nombre ".pdf") 
               "_N" "_Y")))
  
  (prompt "\n✅ PLANOS FINALES COMPUESTOS")
  (princ))</pre>
          </div>
